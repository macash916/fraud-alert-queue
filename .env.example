# Copy this file to .env and set a real password:  cp .env.example .env
# .env is gitignored. Never commit it.

# PostgreSQL (system of record)
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fraud
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MLflow (experiment tracking). Host port 5001 because macOS uses 5000 for AirPlay.
MLFLOW_PORT=5001
MLFLOW_TRACKING_URI=http://localhost:5001

# Secret key for hashing card numbers into tokens (PCI DSS).
# Generate one with: openssl rand -hex 32
CARD_TOKEN_KEY=change_me
