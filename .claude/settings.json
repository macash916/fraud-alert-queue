{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ruff_on_edit.sh",
            "timeout": 30,
            "statusMessage": "Linting with ruff"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests_on_stop.sh",
            "timeout": 180,
            "statusMessage": "Running the test suite"
          }
        ]
      }
    ]
  }
}
